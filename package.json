{
  "name": "dsh-secret-scrub",
  "description": "Secret-scrubbing guard plugin: irreversible regex redaction of secrets before session-log persistence and model requests",
  "version": "0.1.2",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkt-check/dsh-secret-scrub.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./rules": {
      "types": "./lib/rules.d.ts",
      "default": "./lib/rules.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "author": "jkt-check",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "secret",
    "secrets",
    "redaction",
    "scrubber",
    "plugin",
    "privacy",
    "security",
    "llm"
  ],
  "homepage": "https://github.com/jkt-check/dsh-secret-scrub#readme",
  "bugs": {
    "url": "https://github.com/jkt-check/dsh-secret-scrub/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
